{
  "manifest_version": 3,
  "name": "Miruro Discord Presence",
  "version": "1.0.0",
  "description": "Shows the anime you're watching on Miruro as your Discord status.",
  "host_permissions": [
    "*://*.miruro.tv/*",
    "*://*.miruro.to/*",
    "*://*.miruro.online/*",
    "*://*.miruro.io/*",
    "*://*.miruro.com/*",
    "http://127.0.0.1:6969/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.miruro.tv/*",
        "*://*.miruro.to/*",
        "*://*.miruro.online/*",
        "*://*.miruro.io/*",
        "*://*.miruro.com/*",
        "*://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Miruro Discord Presence"
  }
}